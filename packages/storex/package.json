{
  "name": "storexjs",
  "version": "0.1.0",
  "description": "StoreX - Storage API for ResourceX applications",
  "keywords": [
    "storex",
    "resourcex",
    "storage",
    "cas",
    "registry"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deepractice/ResourceX.git"
  },
  "homepage": "https://github.com/Deepractice/ResourceX",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@resourcexjs/core": "workspace:*"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
